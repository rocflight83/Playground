{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "types": [
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "vitest.config.ts"
  ]
}
