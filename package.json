{
  "name": "playground",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "generate": "node --experimental-strip-types --import ./scripts/proxy-preload.mjs scripts/generate.ts",
    "verify": "node --experimental-strip-types --import ./scripts/proxy-preload.mjs scripts/verify.ts",
    "redo": "node --experimental-strip-types --import ./scripts/proxy-preload.mjs scripts/redo.ts",
    "curate": "node --experimental-strip-types --import ./scripts/proxy-preload.mjs scripts/curate.ts",
    "app": "node --experimental-strip-types --env-file-if-exists=.env --import ./scripts/proxy-preload.mjs scripts/app.ts",
    "dry-run": "node --experimental-strip-types --env-file-if-exists=.env --import ./scripts/proxy-preload.mjs scripts/dry-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "dependencies": {
    "openai": "^7.18.0",
    "zod": "^4.6.2"
  }
}
